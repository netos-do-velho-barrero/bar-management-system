<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseAppHost>false</UseAppHost> <!-- ADICIONADO AQUI PARA DESTRAVAR -->

    <UserSecretsId>daa13d4c-2cd8-4a70-bdb3-54ce7be1d237</UserSecretsId>

    <!-- Restringe o publish para o runtime do Azure (Windows x64), evitando empacotar
         bibliotecas nativas de macOS, Linux, ARM, x86 etc. que não são usadas -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AutoMapper" Version="16.1.1" />

    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="10.0.9" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.9">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ControleDeBar.Aplicacao\ControleDeBar.Aplicacao.csproj" />
    <ProjectReference Include="..\ControleDeBar.Infra\ControleDeBar.Infra.csproj" />
  </ItemGroup>

</Project>
