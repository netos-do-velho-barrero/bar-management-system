@{
    Layout = "_Layout";
    ViewBag.Titulo = "Página Inicial";
}

<div class="row g-2">
    <div class="col-lg-7">
        <h1 class="display-5 fw-semibold mb-3">Controle De Bar</h1>
        <p class="lead text-secondary mb-4">
            Gerencie mesas, garçons, produtos e contas do seu estabelecimento de forma simples e eficiente.
        </p>
    </div>

    <div class="col-lg-5">
        <div class="card border-primary-subtle shadow-sm">
            <div class="card-body p-4">
                <h3 class="h5 text-primary mb-3">Módulos disponíveis</h3>

                <div class="list-group">
                    <span class="text-muted small">Nenhum módulo cadastrado até o momento.</span>
                </div>
            </div>
        </div>
    </div>
</div>
