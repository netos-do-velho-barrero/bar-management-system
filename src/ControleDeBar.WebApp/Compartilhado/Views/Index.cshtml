@{
    Layout = "_Layout";
    ViewBag.Titulo = "";
}

@if (User.Identity?.IsAuthenticated == true)
{
    <!-- Dashboard Autenticado -->
    <div class="dashboard-header">
        <span class="badge bg-primary-subtle text-primary mb-2 px-3 py-2 rounded-3 fw-semibold">
            <i class="bi bi-speedometer2 me-1"></i> Painel de Controle
        </span>
        <h1 class="display-5 fw-bold text-dark mb-2">
            Bem-vindo ao seu Bar! 🍻
        </h1>
        <p class="lead text-muted">
            Gerencie mesas, pedidos, garçons e produtos em uma plataforma simples, rápida e segura.
        </p>
    </div>

    <!-- Cards de Ação Rápida -->
    <div class="row g-3 mb-5">
        <div class="col-lg-4 col-md-6">
            <div class="module-card">
                <div class="module-icon">
                    <i class="bi bi-receipt"></i>
                </div>
                <div class="module-content flex-grow-1">
                    <h3>Contas Ativas</h3>
                    <p>Abra e gerencie contas dos clientes</p>
                </div>
                <a href="@Url.Action("Listar", "Conta")" class="btn btn-sm btn-primary rounded-2">
                    <i class="bi bi-arrow-right"></i>
                </a>
            </div>
        </div>

        <div class="col-lg-4 col-md-6">
            <div class="module-card">
                <div class="module-icon">
                    <i class="bi bi-graph-up-arrow"></i>
                </div>
                <div class="module-content flex-grow-1">
                    <h3>Faturamento</h3>
                    <p>Acompanhe o faturamento do dia</p>
                </div>
                <a href="@Url.Action("Diario", "Faturamento")" class="btn btn-sm btn-primary rounded-2">
                    <i class="bi bi-arrow-right"></i>
                </a>
            </div>
        </div>

        <div class="col-lg-4 col-md-6">
            <div class="module-card">
                <div class="module-icon">
                    <i class="bi bi-grid-3x3-gap"></i>
                </div>
                <div class="module-content flex-grow-1">
                    <h3>Mesas</h3>
                    <p>Cadastre e gerencie suas mesas</p>
                </div>
                <a href="@Url.Action("Listar", "Mesa")" class="btn btn-sm btn-primary rounded-2">
                    <i class="bi bi-arrow-right"></i>
                </a>
            </div>
        </div>
    </div>

    <!-- Seção de Módulos -->
    <div>
        <h2 class="h4 fw-bold text-dark mb-4">
            <i class="bi bi-puzzle me-2 text-primary"></i>Todos os Módulos
        </h2>

        <div class="row g-3">
            <div class="col-lg-6">
                <a href="@Url.Action("Listar", "Produto")" class="module-card text-decoration-none">
                    <div class="module-icon bg-info-subtle text-info">
                        <i class="bi bi-box-seam"></i>
                    </div>
                    <div class="module-content">
                        <h3>Produtos</h3>
                        <p class="text-muted">Gerencie o cardápio e preços</p>
                    </div>
                    <i class="bi bi-chevron-right text-muted"></i>
                </a>
            </div>

            <div class="col-lg-6">
                <a href="@Url.Action("Listar", "Garcom")" class="module-card text-decoration-none">
                    <div class="module-icon bg-success-subtle text-success">
                        <i class="bi bi-person-badge"></i>
                    </div>
                    <div class="module-content">
                        <h3>Garçons</h3>
                        <p class="text-muted">Administre sua equipe de atendimento</p>
                    </div>
                    <i class="bi bi-chevron-right text-muted"></i>
                </a>
            </div>

            <div class="col-lg-6">
                <a href="@Url.Action("Listar", "Conta")" class="module-card text-decoration-none">
                    <div class="module-icon bg-warning-subtle text-warning">
                        <i class="bi bi-receipt"></i>
                    </div>
                    <div class="module-content">
                        <h3>Contas</h3>
                        <p class="text-muted">Abra, edite e feche contas</p>
                    </div>
                    <i class="bi bi-chevron-right text-muted"></i>
                </a>
            </div>

            <div class="col-lg-6">
                <a href="@Url.Action("Diario", "Faturamento")" class="module-card text-decoration-none">
                    <div class="module-icon bg-danger-subtle text-danger">
                        <i class="bi bi-graph-up-arrow"></i>
                    </div>
                    <div class="module-content">
                        <h3>Faturamento</h3>
                        <p class="text-muted">Acompanhe ganhos e movimentações</p>
                    </div>
                    <i class="bi bi-chevron-right text-muted"></i>
                </a>
            </div>
        </div>
    </div>

    <!-- Card de Informação Segurança -->
    <div class="alert alert-info mt-5 border-start border-4 rounded-3" role="alert">
        <div class="d-flex gap-3">
            <div>
                <i class="bi bi-shield-check text-info fs-4"></i>
            </div>
            <div>
                <h5 class="alert-heading">Sistema Multi-Usuário Seguro</h5>
                <p class="mb-0">
                    Seus dados estão 100% seguros e isolados. Cada bar é um ambiente independente. 
                    Nenhum outro usuário consegue acessar suas informações, mesas, garçons ou contas.
                </p>
            </div>
        </div>
    </div>
}
else
{
    <!-- Página Inicial (Não Autenticado) -->
    <div class="row align-items-center g-5 py-5">
        <!-- Lado Esquerdo: Banner de Boas-vindas -->
        <div class="col-lg-6">
            <span class="badge bg-primary mb-3 px-3 py-2 rounded-3 fw-semibold">
                <i class="bi bi-cup-hot-fill me-1"></i> Gestão Inteligente
            </span>
            <h1 class="display-4 fw-bold text-dark mb-4">
                Controle seu bar com facilidade
            </h1>
            <p class="lead text-muted mb-4">
                Sistema seguro para gerenciar mesas, atendimentos, cardápio e fechamento de contas. 
                Cada bar é um ambiente isolado com total segurança.
            </p>

            <div class="d-flex gap-3 flex-wrap">
                <a asp-controller="Autenticacao" asp-action="Entrar" class="btn btn-primary btn-lg rounded-3 px-5 fw-bold">
                    <i class="bi bi-box-arrow-in-right me-2"></i>Entrar
                </a>
                <a asp-controller="Autenticacao" asp-action="Registrar" class="btn btn-outline-primary btn-lg rounded-3 px-5 fw-bold">
                    <i class="bi bi-person-plus me-2"></i>Criar Conta
                </a>
            </div>

            <div class="mt-5">
                <p class="text-muted small">
                    <i class="bi bi-shield-check text-success me-2"></i>
                    <strong>Sistema seguro e isolado</strong> | Nenhum bar acessa dados de outro
                </p>
            </div>
        </div>

        <!-- Lado Direito: Features -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-lg rounded-4">
                <div class="card-body p-4">
                    <h2 class="h5 fw-bold text-dark mb-4">
                        <i class="bi bi-star-fill text-warning me-2"></i> Recursos Principais
                    </h2>

                    <div class="d-flex gap-3 mb-3">
                        <div class="flex-shrink-0">
                            <div class="p-2 bg-primary-subtle text-primary rounded-3">
                                <i class="bi bi-grid-3x3-gap"></i>
                            </div>
                        </div>
                        <div>
                            <h6 class="fw-bold text-dark">Gestão de Mesas</h6>
                            <p class="text-muted small mb-0">Cadastre mesas e controle sua ocupação em tempo real</p>
                        </div>
                    </div>

                    <div class="d-flex gap-3 mb-3">
                        <div class="flex-shrink-0">
                            <div class="p-2 bg-info-subtle text-info rounded-3">
                                <i class="bi bi-receipt"></i>
                            </div>
                        </div>
                        <div>
                            <h6 class="fw-bold text-dark">Contas Dinâmicas</h6>
                            <p class="text-muted small mb-0">Abra, edite e feche contas com facilidade</p>
                        </div>
                    </div>

                    <div class="d-flex gap-3 mb-3">
                        <div class="flex-shrink-0">
                            <div class="p-2 bg-success-subtle text-success rounded-3">
                                <i class="bi bi-box-seam"></i>
                            </div>
                        </div>
                        <div>
                            <h6 class="fw-bold text-dark">Cardápio Online</h6>
                            <p class="text-muted small mb-0">Gerencie produtos e preços do seu bar</p>
                        </div>
                    </div>

                    <div class="d-flex gap-3">
                        <div class="flex-shrink-0">
                            <div class="p-2 bg-warning-subtle text-warning rounded-3">
                                <i class="bi bi-graph-up-arrow"></i>
                            </div>
                        </div>
                        <div>
                            <h6 class="fw-bold text-dark">Relatório de Faturamento</h6>
                            <p class="text-muted small mb-0">Acompanhe seus ganhos e movimentações</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Segurança Multi-Tenant -->
    <div class="row mt-5 gy-4">
        <div class="col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <h5 class="card-title fw-bold text-dark mb-3">
                        <i class="bi bi-shield-check text-success me-2"></i>Segurança Total
                    </h5>
                    <p class="text-muted">
                        Sistema com isolamento completo entre usuários. Seus dados, mesas e contas são 100% privados.
                    </p>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <h5 class="card-title fw-bold text-dark mb-3">
                        <i class="bi bi-lightning-charge text-warning me-2"></i>Rápido e Simples
                    </h5>
                    <p class="text-muted">
                        Interface intuitiva e fácil de usar. Seu bar estará totalmente configurado em minutos.
                    </p>
                </div>
            </div>
        </div>
    </div>
}

                    <a asp-controller="Garcom" asp-action="Listar" class="list-group-item list-group-item-action border rounded-3 p-3 d-flex align-items-center justify-content-between">
                        <div class="d-flex align-items-center gap-3">
                            <div class="p-2 bg-success-subtle text-success rounded-3">
                                <i class="bi bi-person-badge fs-4"></i>
                            </div>
                            <div>
                                <div class="fw-bold text-dark">Garçons</div>
                                <small class="text-muted">Gerencie a equipe de atendimento do bar.</small>
                            </div>
                        </div>
                        <i class="bi bi-chevron-right text-muted"></i>
                    </a>

                    <a asp-controller="Produto" asp-action="Listar" class="list-group-item list-group-item-action border rounded-3 p-3 d-flex align-items-center justify-content-between">
                        <div class="d-flex align-items-center gap-3">
                            <div class="p-2 bg-warning-subtle text-warning-emphasis rounded-3">
                                <i class="bi bi-box-seam fs-4"></i>
                            </div>
                            <div>
                                <div class="fw-bold text-dark">Produtos</div>
                                <small class="text-muted">Cadastre itens e preços do cardápio.</small>
                            </div>
                        </div>
                        <i class="bi bi-chevron-right text-muted"></i>
                    </a>

                    <a asp-controller="Conta" asp-action="Listar" class="list-group-item list-group-item-action border rounded-3 p-3 d-flex align-items-center justify-content-between">
                        <div class="d-flex align-items-center gap-3">
                            <div class="p-2 bg-info-subtle text-info-emphasis rounded-3">
                                <i class="bi bi-receipt fs-4"></i>
                            </div>
                            <div>
                                <div class="fw-bold text-dark">Contas</div>
                                <small class="text-muted">Abra, adicione pedidos e encerre comandas.</small>
                            </div>
                        </div>
                        <i class="bi bi-chevron-right text-muted"></i>
                    </a>

                    <a asp-controller="Faturamento" asp-action="Diario" class="list-group-item list-group-item-action border rounded-3 p-3 d-flex align-items-center justify-content-between">
                        <div class="d-flex align-items-center gap-3">
                            <div class="p-2 bg-danger-subtle text-danger rounded-3">
                                <i class="bi bi-graph-up-arrow fs-4"></i>
                            </div>
                            <div>
                                <div class="fw-bold text-dark">Faturamento Diário</div>
                                <small class="text-muted">Acompanhe métricas, relatórios e totais por data.</small>
                            </div>
                        </div>
                        <i class="bi bi-chevron-right text-muted"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
