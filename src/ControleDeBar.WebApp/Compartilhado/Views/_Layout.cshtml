<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Titulo - Controle De Bar</title>

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">

    <!-- Custom CSS -->
    <link href="@Url.Content("~/css/custom.css")" rel="stylesheet">
</head>

<body class="d-flex flex-column min-vh-100">

    <!-- Barra de Navegação -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm">
        <div class="container">
            <a class="navbar-brand fw-bold d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index">
                <i class="bi bi-cup-hot-fill text-primary"></i>
                <span>Controle De Bar</span>
            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menuPrincipal"
                    aria-controls="menuPrincipal" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="menuPrincipal">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-3">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house"></i> Início
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Mesa" asp-action="Listar">
                                <i class="bi bi-grid-3x3-gap"></i> Mesas
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Garcom" asp-action="Listar">
                                <i class="bi bi-person-badge"></i> Garçons
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Produto" asp-action="Listar">
                                <i class="bi bi-box-seam"></i> Produtos
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Conta" asp-action="Listar">
                                <i class="bi bi-receipt"></i> Contas
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Faturamento" asp-action="Diario">
                                <i class="bi bi-graph-up-arrow"></i> Faturamento
                            </a>
                        </li>
                    </ul>

                    <div class="dropdown ms-auto">
                        <button
                            class="btn btn-outline-light rounded-pill btn-sm dropdown-toggle d-flex align-items-center gap-2 px-3"
                            type="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bi bi-person-circle"></i>
                            <span>@User.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value</span>
                        </button>

                        <ul class="dropdown-menu dropdown-menu-end shadow border-0 mt-2">
                            <li>
                                <form asp-controller="Autenticacao" asp-action="Sair" method="post" class="d-inline">
                                    <button type="submit" class="dropdown-item text-danger d-flex align-items-center gap-2">
                                        <i class="bi bi-box-arrow-right"></i> Sair
                                    </button>
                                </form>
                            </li>
                        </ul>
                    </div>
                }
                else
                {
                    <div class="navbar-nav ms-auto gap-2">
                        <a class="btn btn-outline-light btn-sm rounded-pill px-3" asp-controller="Autenticacao"
                           asp-action="Entrar">
                            <i class="bi bi-box-arrow-in-right"></i> Entrar
                        </a>
                        <a class="btn btn-primary btn-sm rounded-pill px-3" asp-controller="Autenticacao"
                           asp-action="Registrar">
                            <i class="bi bi-person-plus"></i> Registrar
                        </a>
                    </div>
                }
            </div>
        </div>
    </nav>

    <!-- Indicador de Multi-Tenancy -->
    @if (User.Identity?.IsAuthenticated == true)
    {
        <div class="bg-light border-bottom py-3 shadow-sm">
            <div class="container">
                <div class="tenant-indicator">
                    <div class="tenant-info">
                        <i class="bi bi-building"></i>
                        <span>
                            Você está acessando como:
                            <strong>@User.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value</strong>
                        </span>
                    </div>
                    <div class="tenant-badge">
                        <i class="bi bi-shield-check"></i> Sistema Seguro Multi-Usuário
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Cabeçalho Principal -->
    @if (!string.IsNullOrEmpty(ViewBag.Titulo as string))
    {
        <header class="bg-white border-bottom py-3 mb-4 shadow-sm">
            <div class="container">
                <h1 class="h3 fw-bold mb-0 text-dark">
                    <i class="bi bi-bookmark-fill text-primary me-2"></i>@ViewBag.Titulo
                </h1>
            </div>
        </header>
    }

    <!-- Conteúdo Principal -->
    <main class="container my-4 flex-grow-1">
        @RenderBody()
    </main>

    <!-- Rodapé -->
    <footer class="bg-white border-top py-3 text-center text-muted mt-auto">
        <div class="container">
            <small>&copy; @DateTime.Now.Year - Controle De Bar. Todos os direitos reservados.</small>
        </div>
    </footer>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>
