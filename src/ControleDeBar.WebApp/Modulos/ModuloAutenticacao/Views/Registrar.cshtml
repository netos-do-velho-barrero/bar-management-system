@using ControleDeBar.WebApp.Modulos.ModuloAutenticacao

@{
    Layout = "_Layout";
    ViewBag.Titulo = "Criar Conta";
}

@model RegistrarViewModel

<div class="auth-container">
    <div class="auth-card">
        <div class="auth-header">
            <h1 class="h2">
                <i class="bi bi-cup-hot-fill text-primary"></i>
            </h1>
            <h1 class="h3">Comece agora!</h1>
            <p>Crie sua conta e gerencie seu bar com segurança</p>
        </div>

        <div class="auth-body">
            <form asp-action="Registrar" method="post" novalidate>
                <div asp-validation-summary="ModelOnly" class="alert alert-danger alert-dismissible fade show"
                     role="alert">
                    <i class="bi bi-exclamation-circle me-2"></i>
                    <div asp-validation-summary="ModelOnly"></div>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button>
                </div>

                <div class="mb-4">
                    <label asp-for="Email" class="form-label">
                        <i class="bi bi-envelope me-2 text-primary"></i>E-mail
                    </label>
                    <input asp-for="Email" type="email" class="form-control form-control-lg" placeholder="seu@email.com"
                           autocomplete="email">
                    <span asp-validation-for="Email" class="invalid-feedback d-block mt-2"></span>
                    <small class="text-muted d-block mt-2">
                        <i class="bi bi-info-circle me-1"></i>Use um e-mail válido para acesso futuro
                    </small>
                </div>

                <div class="mb-4">
                    <label asp-for="Senha" class="form-label">
                        <i class="bi bi-lock me-2 text-primary"></i>Senha
                    </label>
                    <input asp-for="Senha" type="password" class="form-control form-control-lg" placeholder="••••••••"
                           autocomplete="new-password">
                    <span asp-validation-for="Senha" class="invalid-feedback d-block mt-2"></span>
                    <small class="text-muted d-block mt-2">
                        <i class="bi bi-shield-check me-1"></i>Mínimo 6 caracteres
                    </small>
                </div>

                <div class="mb-4">
                    <label asp-for="ConfirmarSenha" class="form-label">
                        <i class="bi bi-lock-fill me-2 text-primary"></i>Confirmar Senha
                    </label>
                    <input asp-for="ConfirmarSenha" type="password" class="form-control form-control-lg"
                           placeholder="••••••••" autocomplete="new-password">
                    <span asp-validation-for="ConfirmarSenha" class="invalid-feedback d-block mt-2"></span>
                </div>

                <button type="submit" class="btn btn-primary btn-lg w-100 rounded-3 fw-bold mb-3">
                    <i class="bi bi-person-plus me-2"></i>Criar Conta
                </button>

                <div class="text-center">
                    <p class="text-muted mb-2">Já tem conta?</p>
                    <a asp-action="Entrar" class="btn btn-outline-primary w-100 rounded-3 fw-bold">
                        <i class="bi bi-box-arrow-in-right me-2"></i>Voltar para entrar
                    </a>
                </div>

                <div class="alert alert-info mt-4 small">
                    <i class="bi bi-shield-check me-2"></i>
                    <strong>Segurança Total:</strong> Seus dados são isolados. Nenhum bar tem acesso aos dados de outro.
                </div>
            </form>
        </div>
    </div>
</div>
