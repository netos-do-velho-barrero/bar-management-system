@using ControleDeBar.WebApp.Modulos.ModuloAutenticacao

@{
    Layout = "_Layout";
    ViewBag.Titulo = "Entrar";
}

@model EntrarViewModel

<div class="auth-container">
    <div class="auth-card">
        <div class="auth-header">
            <h1 class="h2">
                <i class="bi bi-cup-hot-fill text-primary"></i>
            </h1>
            <h1 class="h3">Bem-vindo de volta!</h1>
            <p>Gerencie seu bar com segurança e eficiência</p>
        </div>

        <div class="auth-body">
            <form asp-action="Entrar" method="post" novalidate>
                <div asp-validation-summary="ModelOnly" class="alert alert-danger alert-dismissible fade show"
                     role="alert">
                    <i class="bi bi-exclamation-circle me-2"></i>
                    <div asp-validation-summary="ModelOnly"></div>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button>
                </div>

                <input type="hidden" asp-for="ReturnUrl">

                <div class="mb-4">
                    <label asp-for="Email" class="form-label">
                        <i class="bi bi-envelope me-2 text-primary"></i>E-mail
                    </label>
                    <input asp-for="Email" type="email" class="form-control form-control-lg" placeholder="seu@email.com"
                           autofocus autocomplete="email">
                    <span asp-validation-for="Email" class="invalid-feedback d-block mt-2"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Senha" class="form-label">
                        <i class="bi bi-lock me-2 text-primary"></i>Senha
                    </label>
                    <input asp-for="Senha" type="password" class="form-control form-control-lg" placeholder="••••••••"
                           autocomplete="current-password">
                    <span asp-validation-for="Senha" class="invalid-feedback d-block mt-2"></span>
                </div>

                <div class="form-check mb-4">
                    <input asp-for="LembrarMe" type="checkbox" class="form-check-input" id="lembrarMe">
                    <label class="form-check-label" for="lembrarMe">
                        Lembrar-me neste dispositivo
                    </label>
                </div>

                <button type="submit" class="btn btn-primary btn-lg w-100 rounded-3 fw-bold mb-3">
                    <i class="bi bi-box-arrow-in-right me-2"></i>Entrar
                </button>

                <div class="text-center">
                    <p class="text-muted mb-2">Não tem conta?</p>
                    <a asp-action="Registrar" class="btn btn-outline-primary w-100 rounded-3 fw-bold">
                        <i class="bi bi-person-plus me-2"></i>Criar uma nova conta
                    </a>
                </div>

                <div class="alert alert-info mt-4 small">
                    <i class="bi bi-shield-check me-2"></i>
                    <strong>Sistema Seguro:</strong> Seus dados são protegidos. Cada bar possui isolamento total.
                </div>
            </form>
        </div>
    </div>
</div>
