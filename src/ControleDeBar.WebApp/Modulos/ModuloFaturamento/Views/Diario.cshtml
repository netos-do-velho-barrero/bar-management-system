@model ControleDeBar.WebApp.Modulos.ModuloFaturamento.FaturamentoDiarioViewModel
@{
    Layout = "_Layout";
    ViewBag.Titulo = "Faturamento Diário";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Faturamento Diário</h2>

    <form method="get" asp-controller="Faturamento" asp-action="Diario" class="d-flex align-items-center gap-2">
        <label for="data" class="form-label mb-0 fw-semibold">Data:</label>
        <input type="date" id="data" name="data" value="@Model.Data.ToString("yyyy-MM-dd")" class="form-control form-control-sm" style="width: 170px;" />
        <button type="submit" class="btn btn-primary btn-sm px-3 rounded-pill">Filtrar</button>
    </form>
</div>

<!-- Cards Resumo -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card border-success shadow-sm">
            <div class="card-body">
                <h6 class="card-subtitle text-muted mb-1">Total Faturado</h6>
                <h3 class="card-title text-success fw-bold mb-0">@Model.TotalFaturado.ToString("C")</h3>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-primary shadow-sm">
            <div class="card-body">
                <h6 class="card-subtitle text-muted mb-1">Contas Fechadas</h6>
                <h3 class="card-title text-primary fw-bold mb-0">@Model.QuantidadeContas</h3>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-info shadow-sm">
            <div class="card-body">
                <h6 class="card-subtitle text-muted mb-1">Ticket Médio</h6>
                <h3 class="card-title text-info fw-bold mb-0">@Model.TicketMedio.ToString("C")</h3>
            </div>
        </div>
    </div>
</div>

<!-- Tabela de Contas Fechadas no Dia -->
<div class="card border-primary-subtle shadow-sm">
    <div class="card-body">
        <h5 class="card-title mb-3">Contas encerradas em @Model.Data.ToString("dd/MM/yyyy")</h5>

        @if (Model.ContasFechadas.Count == 0)
        {
            <div class="alert alert-primary border-start border-primary border-4 rounded-3" role="alert">
                Nenhuma conta encerrada nesta data.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead>
                        <tr class="text-secondary text-uppercase small">
                            <th>Mesa</th>
                            <th>Garçom</th>
                            <th>Cliente</th>
                            <th>Abertura</th>
                            <th>Fechamento</th>
                            <th class="text-end">Valor Total</th>
                            <th class="text-end" style="width: 100px;">Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.ContasFechadas)
                        {
                            <tr>
                                <td>Mesa @item.NumeroMesa</td>
                                <td>@item.NomeGarcom</td>
                                <td>@(string.IsNullOrWhiteSpace(item.NomeCliente) ? "-" : item.NomeCliente)</td>
                                <td>@item.DataAbertura.ToString("HH:mm")</td>
                                <td>@(item.DataFechamento?.ToString("HH:mm") ?? "-")</td>
                                <td class="text-end fw-bold text-success">@item.ValorTotal.ToString("C")</td>
                                <td class="text-end">
                                    <a asp-controller="Conta" asp-action="Detalhes" asp-route-id="@item.Id" class="btn btn-outline-primary btn-sm rounded-pill px-3">
                                        Detalhes
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <td colspan="5" class="text-end fw-bold text-uppercase small text-primary">Total do Dia</td>
                            <td class="text-end fw-bold text-success">@Model.TotalFaturado.ToString("C")</td>
                            <td></td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        }
    </div>
</div>
