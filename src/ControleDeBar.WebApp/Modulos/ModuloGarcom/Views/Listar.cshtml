@model List<ControleDeBar.WebApp.Modulos.ModuloGarcom.ListarGarcomViewModel>

@{
    ViewData["Title"] = "Garçons";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Garçons</h1>

    <a asp-action="Cadastrar" class="btn btn-primary">
        Cadastrar Garçom
    </a>
</div>

@if (Model.Count == 0)
{
    <div class="alert alert-info">
        Nenhum garçom cadastrado.
    </div>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Nome</th>
                <th class="text-end">Ações</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var garcom in Model)
            {
                <tr>
                    <td>@garcom.Nome</td>

                    <td class="text-end">
                        <a asp-action="Detalhes" asp-route-id="@garcom.Id" class="btn btn-sm btn-secondary">
                            Detalhes
                        </a>

                        <a asp-action="Editar" asp-route-id="@garcom.Id" class="btn btn-sm btn-primary">
                            Editar
                        </a>

                        <a asp-action="Excluir" asp-route-id="@garcom.Id" class="btn btn-sm btn-danger">
                            Excluir
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
