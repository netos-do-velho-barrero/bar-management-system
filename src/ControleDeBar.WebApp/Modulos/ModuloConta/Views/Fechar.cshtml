@model ControleDeBar.WebApp.Modulos.ModuloConta.DetalhesContaViewModel

@{
    ViewData["Title"] = "Fechar Conta";
}

<div class="card">

    <div class="card-body">

        <h1 class="mb-4">
            Fechar Conta
        </h1>

        <div class="mb-3">
            <strong>Mesa:</strong>
            @Model.NumeroMesa
        </div>

        <div class="mb-3">
            <strong>Garçom:</strong>
            @Model.NomeGarcom
        </div>

        <div class="mb-3">
            <strong>Cliente:</strong>
            @Model.NomeCliente
        </div>

        <div class="mb-3">
            <strong>Data de abertura:</strong>
            @Model.DataAbertura.ToString("dd/MM/yyyy HH:mm")
        </div>

        <div class="mb-4">
            <strong>Valor total:</strong>
            @Model.ValorTotal.ToString("C")
        </div>

        <div class="alert alert-warning">
            Tem certeza que deseja fechar esta conta?
            Depois de fechada, ela não poderá mais ser editada.
        </div>

        <form asp-action="Fechar" method="post">

            <input type="hidden" asp-for="Id" />

            <button type="submit" class="btn btn-danger">
                Confirmar Fechamento
            </button>

            <a asp-action="Listar" class="btn btn-secondary">
                Cancelar
            </a>

        </form>

    </div>

</div>
