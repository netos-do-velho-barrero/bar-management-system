@model ControleDeBar.WebApp.Modulos.ModuloConta.AbrirContaViewModel

@{
    ViewData["Title"] = "Abrir Conta";

    var mesas = ViewBag.Mesas as List<ControleDeBar.WebApp.Modulos.ModuloConta.OpcaoMesaContaViewModel>
        ?? [];

    var garcons = ViewBag.Garcons as List<ControleDeBar.WebApp.Modulos.ModuloConta.OpcaoGarcomContaViewModel>
        ?? [];
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Abrir Conta</h1>

    <a asp-action="Listar" class="btn btn-secondary">
        Voltar
    </a>
</div>

<div class="card">
    <div class="card-body">

        <form asp-action="Abrir" method="post">

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="MesaId" class="form-label">
                    Mesa
                </label>

                <select asp-for="MesaId" class="form-select">
                    <option value="">Selecione uma mesa</option>

                    @foreach (var mesa in mesas)
                    {
                        <option value="@mesa.Id">
                            Mesa @mesa.Numero
                        </option>
                    }
                </select>

                <span asp-validation-for="MesaId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="GarcomId" class="form-label">
                    Garçom
                </label>

                <select asp-for="GarcomId" class="form-select">
                    <option value="">Selecione um garçom</option>

                    @foreach (var garcom in garcons)
                    {
                        <option value="@garcom.Id">
                            @garcom.Nome
                        </option>
                    }
                </select>

                <span asp-validation-for="GarcomId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="NomeCliente" class="form-label">
                    Nome do cliente
                </label>

                <input asp-for="NomeCliente" class="form-control" placeholder="Digite o nome do cliente" />

                <span asp-validation-for="NomeCliente" class="text-danger"></span>
            </div>

            <div class="d-flex justify-content-end gap-2">
                <a asp-action="Listar" class="btn btn-secondary">
                    Cancelar
                </a>

                <button type="submit" class="btn btn-primary">
                    Abrir Conta
                </button>
            </div>

        </form>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
