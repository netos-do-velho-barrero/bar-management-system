@model ControleDeBar.WebApp.Modulos.ModuloConta.DetalhesContaViewModel

@{
    ViewData["Title"] = "Detalhes da Conta";
}

<h1>Detalhes da Conta</h1>

<div class="card mb-4">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">
                Mesa
            </dt>

            <dd class="col-sm-9">
                Mesa @Model.NumeroMesa
            </dd>

            <dt class="col-sm-3">
                Garçom
            </dt>

            <dd class="col-sm-9">
                @Model.NomeGarcom
            </dd>

            <dt class="col-sm-3">
                Cliente
            </dt>

            <dd class="col-sm-9">
                @Model.NomeCliente
            </dd>

            <dt class="col-sm-3">
                Data de abertura
            </dt>

            <dd class="col-sm-9">
                @Model.DataAbertura.ToString("dd/MM/yyyy")
            </dd>

            <dt class="col-sm-3">
                Situação
            </dt>

            <dd class="col-sm-9">
                @Model.Situacao
            </dd>

            <dt class="col-sm-3">
                Valor total
            </dt>

            <dd class="col-sm-9">
                @Model.ValorTotal.ToString("C")
            </dd>
        </dl>

        @if (Model.Situacao == "Aberta")
        {
            <a asp-action="Editar" asp-route-id="@Model.Id" class="btn btn-primary">
                Editar
            </a>

            <form asp-action="Fechar" asp-route-id="@Model.Id" method="post" class="d-inline">
                <button type="submit" class="btn btn-success">
                    Fechar Conta
                </button>
            </form>
        }

        <a asp-action="Listar" class="btn btn-secondary">
            Voltar
        </a>
    </div>
</div>

@* Substitui o bloco antigo de <h2>Pedidos</h2> + tabela somente-leitura pela
   partial, que já traz: botão "Adicionar Produto", form de editar quantidade
   inline e botão "Remover" por item — tudo condicionado a Situacao == "Aberta"
   dentro da própria partial, então não precisa repetir esse if aqui. *@
@await Html.PartialAsync("~/Modulos/ModuloPedidoConta/Views/Listar.cshtml", Model)
