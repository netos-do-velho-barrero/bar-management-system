@{
    Layout = "_Layout";
    ViewBag.Titulo = "Detalhes da Conta";
}

@model ControleDeBar.WebApp.Modulos.ModuloConta.DetalhesContaViewModel;

<div class="card border-primary-subtle shadow-sm mx-auto p-4" style="max-width: 720px;">

    <dl class="row mb-0">

        <dt class="col-sm-4 fw-semibold text-primary text-uppercase small">
            ID
        </dt>

        <dd class="col-sm-8 text-break">
            @Model.Id
        </dd>

        <dt class="col-sm-4 fw-semibold text-primary text-uppercase small">
            Mesa
        </dt>

        <dd class="col-sm-8">
            <span class="badge bg-info-subtle text-info rounded-2 px-3 py-2">
                <i class="bi bi-grid-3x3-gap me-1"></i>
                Mesa @Model.NumeroMesa
            </span>
        </dd>

        <dt class="col-sm-4 fw-semibold text-primary text-uppercase small">
            Garçom
        </dt>

        <dd class="col-sm-8">
            @Model.NomeGarcom
        </dd>

        <dt class="col-sm-4 fw-semibold text-primary text-uppercase small">
            Cliente
        </dt>

        <dd class="col-sm-8">
            @Model.NomeCliente
        </dd>

        <dt class="col-sm-4 fw-semibold text-primary text-uppercase small">
            Data de Abertura
        </dt>

        <dd class="col-sm-8">
            @Model.DataAbertura.ToString("dd/MM/yyyy HH:mm")
        </dd>

        <dt class="col-sm-4 fw-semibold text-primary text-uppercase small">
            Situação
        </dt>

        <dd class="col-sm-8">
            @if (Model.Situacao == "Aberta")
            {
                <span class="badge bg-success rounded-2 px-3 py-2">
                    <i class="bi bi-unlock me-1"></i>
                    Aberta
                </span>
            }
            else
            {
                <span class="badge bg-danger rounded-2 px-3 py-2">
                    <i class="bi bi-lock me-1"></i>
                    Fechada
                </span>
            }
        </dd>

        <dt class="col-sm-4 fw-semibold text-primary text-uppercase small">
            Valor Total
        </dt>

        <dd class="col-sm-8">
            <strong class="text-dark">
                @Model.ValorTotal.ToString("C")
            </strong>
        </dd>

    </dl>

    <div class="d-flex justify-content-end gap-2 mt-4">

        <a class="btn btn-outline-primary rounded-pill px-4" asp-action="Listar">
            Voltar
        </a>

        @if (Model.Situacao == "Aberta")
        {
            <a class="btn btn-outline-primary rounded-pill px-4" asp-action="Editar" asp-route-id="@Model.Id">
                Editar
            </a>

            <a class="btn btn-outline-success rounded-pill px-4" asp-action="ConfirmarFechamento" asp-route-id="@Model.Id">
                Fechar Conta
            </a>
        }

    </div>
</div>

@await Html.PartialAsync(
    "~/Modulos/ModuloPedidoConta/Views/Listar.cshtml",
    Model)
