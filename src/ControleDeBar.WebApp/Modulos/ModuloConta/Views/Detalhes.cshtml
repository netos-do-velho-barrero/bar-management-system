@model ControleDeBar.WebApp.Modulos.ModuloConta.DetalhesContaViewModel

@{
    ViewData["Title"] = "Detalhes da Conta";
}

<h1>Detalhes da Conta</h1>

<div class="card mb-4">

    <div class="card-body">

        <dl class="row">

            <dt class="col-sm-3">
                Mesa
            </dt>

            <dd class="col-sm-9">
                Mesa @Model.NumeroMesa
            </dd>

            <dt class="col-sm-3">
                Garçom
            </dt>

            <dd class="col-sm-9">
                @Model.NomeGarcom
            </dd>

            <dt class="col-sm-3">
                Cliente
            </dt>

            <dd class="col-sm-9">
                @Model.NomeCliente
            </dd>

            <dt class="col-sm-3">
                Data de abertura
            </dt>

            <dd class="col-sm-9">
                @Model.DataAbertura.ToString("dd/MM/yyyy HH:mm")
            </dd>

            <dt class="col-sm-3">
                Situação
            </dt>

            <dd class="col-sm-9">
                @Model.Situacao
            </dd>

            <dt class="col-sm-3">
                Valor total
            </dt>

            <dd class="col-sm-9">
                @Model.ValorTotal.ToString("C")
            </dd>

        </dl>

        @if (Model.Situacao == "Aberta")
        {
            <a asp-action="Editar" asp-route-id="@Model.Id" class="btn btn-primary">
                Editar
            </a>

            <form asp-action="Fechar" asp-route-id="@Model.Id" method="post" class="d-inline">

                <button type="submit" class="btn btn-success">
                    Fechar Conta
                </button>

            </form>
        }

        <a asp-action="Listar" class="btn btn-secondary">
            Voltar
        </a>

    </div>

</div>

<h2>Pedidos</h2>

@if (Model.Pedidos.Count == 0)
{
    <div class="alert alert-info">
        Nenhum pedido registrado nesta conta.
    </div>
}
else
{
    <table class="table table-striped">

        <thead>
            <tr>
                <th>Produto</th>
                <th>Quantidade</th>
                <th>Preço Unitário</th>
                <th>Subtotal</th>
            </tr>
        </thead>

        <tbody>

            @foreach (var pedido in Model.Pedidos)
            {
                <tr>

                    <td>
                        @pedido.NomeProduto
                    </td>

                    <td>
                        @pedido.Quantidade
                    </td>

                    <td>
                        @pedido.PrecoUnitario.ToString("C")
                    </td>

                    <td>
                        @pedido.Subtotal.ToString("C")
                    </td>

                </tr>
            }

        </tbody>

    </table>
}
