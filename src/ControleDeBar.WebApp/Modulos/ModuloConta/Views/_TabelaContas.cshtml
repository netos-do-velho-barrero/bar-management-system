@using ControleDeBar.WebApp.Modulos.ModuloConta
@model List<ControleDeBar.WebApp.Modulos.ModuloConta.ListarContaViewModel>

@if (Model.Count == 0)
{
    <div class="alert alert-primary border-start border-4 rounded-3">
        <i class="bi bi-inbox me-2"></i>
        <strong>Nenhuma conta nesta categoria.</strong>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>
                        <i class="bi bi-grid-3x3-gap me-2"></i>
                        Mesa
                    </th>

                    <th>
                        <i class="bi bi-person-badge me-2"></i>
                        Garçom
                    </th>

                    <th>
                        <i class="bi bi-person me-2"></i>
                        Cliente
                    </th>

                    <th>
                        <i class="bi bi-calendar me-2"></i>
                        Abertura
                    </th>

                    <th>
                        <i class="bi bi-info-circle me-2"></i>
                        Situação
                    </th>

                    <th>
                        <i class="bi bi-currency-dollar me-2"></i>
                        Total
                    </th>

                    <th class="text-end">
                        <i class="bi bi-gear me-2"></i>
                        Ações
                    </th>
                </tr>
            </thead>

            <tbody>
                @foreach (ListarContaViewModel conta in Model)
                {
                    <tr>
                        <td>
                            <span class="badge bg-info-subtle text-info rounded-2 p-2">
                                <i class="bi bi-grid-3x3-gap me-1"></i>
                                Mesa @conta.NumeroMesa
                            </span>
                        </td>

                        <td>
                            <span class="fw-semibold text-dark">
                                @conta.NomeGarcom
                            </span>
                        </td>

                        <td>
                            @conta.NomeCliente
                        </td>

                        <td>
                            <small class="text-muted">
                                @conta.DataAbertura.ToString(
                                    "dd/MM/yyyy HH:mm",
                                    System.Globalization.CultureInfo.GetCultureInfo("pt-BR"))
                            </small>
                        </td>

                        <td>
                            @if (conta.Situacao == "Aberta")
                            {
                                <span class="badge bg-success rounded-2 px-3 py-2">
                                    <i class="bi bi-unlock me-1"></i>
                                    Aberta
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-danger rounded-2 px-3 py-2">
                                    <i class="bi bi-lock me-1"></i>
                                    Fechada
                                </span>
                            }
                        </td>

                        <td>
                            <strong class="text-dark">
                                @conta.ValorTotal.ToString("C")
                            </strong>
                        </td>

                        <td>
                            <div class="d-flex gap-2 justify-content-end">

                                <a class="btn btn-sm btn-outline-secondary rounded-2" asp-action="Detalhes"
                                   asp-route-id="@conta.Id" title="Visualizar detalhes">
                                    <i class="bi bi-eye"></i>
                                </a>

                                @if (conta.Situacao == "Aberta")
                                {
                                    <a class="btn btn-sm btn-outline-primary rounded-2" asp-action="Editar" asp-route-id="@conta.Id"
                                       title="Editar conta">
                                        <i class="bi bi-pencil"></i>
                                    </a>

                                    <a class="btn btn-sm btn-outline-success rounded-2" asp-action="ConfirmarFechamento"
                                       asp-route-id="@conta.Id" title="Fechar conta">
                                        <i class="bi bi-check-circle"></i>
                                    </a>
                                }

                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
