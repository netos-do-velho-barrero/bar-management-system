@{
    Layout = "_Layout";
    ViewBag.Titulo = "Gerenciar Contas";
}
@model List<ControleDeBar.WebApp.Modulos.ModuloConta.ListarContaViewModel>;

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <p class="text-muted mb-0">
            <i class="bi bi-info-circle me-2"></i>
            Total de contas abertas:
            <strong>
                @Model.Count(c => c.Situacao == "Aberta")
            </strong>
        </p>
    </div>

    <a class="btn btn-primary rounded-3 px-4" asp-action="Abrir">
        <i class="bi bi-plus-lg me-2"></i>
        Abrir Nova Conta
    </a>
</div>

@if (Model.Count == 0)
{
    <div class="alert alert-primary border-start border-4 rounded-3">
        <i class="bi bi-info-circle me-2"></i>

        <strong>Nenhuma conta cadastrada.</strong>
        Comece abrindo uma nova conta!
    </div>
}
else
{
    <div class="nav nav-tabs mb-4" id="filtroContas" role="tablist">

        <button class="nav-link active" id="todas-tab" data-bs-toggle="tab" data-bs-target="#todas" type="button"
                role="tab">

            <i class="bi bi-list me-2"></i>
            Todas

            <span class="badge bg-primary ms-2">
                @Model.Count
            </span>
        </button>

        <button class="nav-link" id="abertas-tab" data-bs-toggle="tab" data-bs-target="#abertas" type="button" role="tab">

            <i class="bi bi-unlock me-2"></i>
            Abertas

            <span class="badge bg-success ms-2">
                @Model.Count(c => c.Situacao == "Aberta")
            </span>
        </button>

        <button class="nav-link" id="fechadas-tab" data-bs-toggle="tab" data-bs-target="#fechadas" type="button" role="tab">

            <i class="bi bi-lock me-2"></i>
            Fechadas

            <span class="badge bg-danger ms-2">
                @Model.Count(c => c.Situacao == "Fechada")
            </span>
        </button>

    </div>

    <div class="tab-content" id="filtroContasContent">

        <div class="tab-pane fade show active" id="todas" role="tabpanel">

            @await Html.PartialAsync(
                "_TabelaContas",
                Model)
        </div>

        <div class="tab-pane fade" id="abertas" role="tabpanel">

            @await Html.PartialAsync(
                "_TabelaContas",
                Model.Where(c => c.Situacao == "Aberta").ToList())
        </div>

        <div class="tab-pane fade" id="fechadas" role="tabpanel">

            @await Html.PartialAsync(
                "_TabelaContas",
                Model.Where(c => c.Situacao == "Fechada").ToList())
        </div>

    </div>

    <div class="alert alert-info mt-4 border-start border-4 rounded-3" role="alert">

        <i class="bi bi-shield-check me-2"></i>

        <strong>Privacidade Garantida:</strong>
        Você só vê contas do seu bar. Nenhum outro usuário tem acesso a
        essas informações.
    </div>
}
