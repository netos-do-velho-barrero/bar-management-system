@{
    Layout = "_Layout";
    ViewBag.Titulo = "Fechar Conta";
}

@model ControleDeBar.WebApp.Modulos.ModuloConta.DetalhesContaViewModel;

<form class="card border-primary-subtle shadow-sm mx-auto p-4" style="max-width: 620px;" asp-action="Fechar"
      method="post">

    <input asp-for="Id" type="hidden">

    <div class="alert alert-warning border-start border-warning border-4 rounded-3" role="alert">

        <i class="bi bi-exclamation-triangle me-2"></i>

        <strong>Deseja realmente fechar esta conta?</strong>

        <div class="small mt-1">
            Depois de fechada, ela não poderá mais ser editada.
        </div>

    </div>

    <dl class="row mb-0">

        <dt class="col-sm-4 fw-semibold text-primary text-uppercase small">
            Mesa
        </dt>

        <dd class="col-sm-8">
            Mesa @Model.NumeroMesa
        </dd>

        <dt class="col-sm-4 fw-semibold text-primary text-uppercase small">
            Garçom
        </dt>

        <dd class="col-sm-8">
            @Model.NomeGarcom
        </dd>

        <dt class="col-sm-4 fw-semibold text-primary text-uppercase small">
            Cliente
        </dt>

        <dd class="col-sm-8">
            @Model.NomeCliente
        </dd>

        <dt class="col-sm-4 fw-semibold text-primary text-uppercase small">
            Data de Abertura
        </dt>

        <dd class="col-sm-8">
            @Model.DataAbertura.ToString("dd/MM/yyyy HH:mm")
        </dd>

        <dt class="col-sm-4 fw-semibold text-primary text-uppercase small">
            Valor Total
        </dt>

        <dd class="col-sm-8">
            <strong class="text-dark">
                @Model.ValorTotal.ToString("C")
            </strong>
        </dd>

    </dl>

    <div class="d-flex justify-content-end gap-2 mt-4">

        <a class="btn btn-outline-primary rounded-pill px-4" asp-action="Listar">
            Cancelar
        </a>

        <button class="btn btn-primary rounded-pill px-4" type="submit">
            Confirmar Fechamento
        </button>

    </div>

</form>
