@model ControleDeBar.WebApp.Modulos.ModuloMesa.DetalhesMesaViewModel

@{
    ViewData["Title"] = "Excluir Mesa";
}

<h1>Excluir Mesa</h1>

<p>Tem certeza que deseja excluir esta mesa?</p>

<dl class="row">
    <dt class="col-sm-3">Número</dt>
    <dd class="col-sm-9">@Model.Numero</dd>

    <dt class="col-sm-3">Quantidade de lugares</dt>
    <dd class="col-sm-9">@Model.QuantidadeLugares</dd>

    <dt class="col-sm-3">Status</dt>
    <dd class="col-sm-9">@Model.Status</dd>
</dl>

<form asp-action="Excluir" method="post">
    <input asp-for="Id" type="hidden" />

    <button type="submit" class="btn btn-danger">
        Confirmar exclusão
    </button>

    <a asp-action="Listar" class="btn btn-secondary">
        Cancelar
    </a>
</form>

