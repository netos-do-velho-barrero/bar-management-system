@{
    Layout = "_Layout";
    ViewBag.Titulo = "Detalhes da Mesa";
}
@model ControleDeBar.WebApp.Modulos.ModuloMesa.DetalhesMesaViewModel;

<div class="card border-primary-subtle shadow-sm mx-auto p-4" style="max-width: 620px;">

    <dl class="row mb-0">
        <dt class="col-sm-4 fw-semibold text-primary text-uppercase small">
            ID
        </dt>

        <dd class="col-sm-8 text-break">
            @Model.Id
        </dd>

        <dt class="col-sm-4 fw-semibold text-primary text-uppercase small">
            Número
        </dt>

        <dd class="col-sm-8">
            @Model.Numero
        </dd>

        <dt class="col-sm-4 fw-semibold text-primary text-uppercase small">
            Quantidade de Lugares
        </dt>

        <dd class="col-sm-8">
            @Model.QuantidadeLugares
        </dd>

        <dt class="col-sm-4 fw-semibold text-primary text-uppercase small">
            Status
        </dt>

        <dd class="col-sm-8">
            @if (Model.Status == "Livre")
            {
                <span class="badge bg-success rounded-2 px-2 py-1">
                    <i class="bi bi-check-circle me-1"></i>
                    Livre
                </span>
            }
            else
            {
                <span class="badge bg-warning text-dark rounded-2 px-2 py-1">
                    <i class="bi bi-exclamation-circle me-1"></i>
                    @Model.Status
                </span>
            }
        </dd>
    </dl>

    <div class="d-flex justify-content-end gap-2 mt-4">
        <a class="btn btn-outline-primary rounded-pill px-4" asp-action="Listar">
            Voltar
        </a>

        <a class="btn btn-outline-primary rounded-pill px-4" asp-action="Editar" asp-route-id="@Model.Id">
            Editar
        </a>

        <a class="btn btn-outline-danger rounded-pill px-4" asp-action="Excluir" asp-route-id="@Model.Id">
            Excluir
        </a>
    </div>
</div>
