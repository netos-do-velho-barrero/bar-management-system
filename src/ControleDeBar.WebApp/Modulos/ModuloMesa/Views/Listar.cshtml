@using ControleDeBar.WebApp.Modulos.ModuloMesa
@model List<ControleDeBar.WebApp.Modulos.ModuloMesa.ListarMesaViewModel>

@{
    Layout = "_Layout";
    ViewBag.Titulo = "Gerenciar Mesas";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <p class="text-muted mb-0">
            <i class="bi bi-info-circle me-2"></i>
            Total de mesas: <strong>@Model.Count</strong> |
            Livres:
            <strong class="text-success">
                @Model.Count(m => m.Status == "Livre")
            </strong> |
            Ocupadas:
            <strong class="text-warning">
                @Model.Count(m => m.Status == "Ocupada")
            </strong>
        </p>
    </div>

    <a class="btn btn-primary rounded-3 px-4" asp-action="Cadastrar">
        <i class="bi bi-plus-lg me-2"></i>
        Cadastrar Nova Mesa
    </a>
</div>

@if (Model.Count == 0)
{
    <div class="alert alert-primary border-start border-4 rounded-3">
        <i class="bi bi-info-circle me-2"></i>
        <strong>Nenhuma mesa cadastrada.</strong>
        Comece cadastrando suas mesas!
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-xl-4 g-3">
        @foreach (ListarMesaViewModel mesa in Model.OrderBy(m => m.Numero))
        {
            <div class="col">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body d-flex flex-column">

                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <div>
                                <h5 class="card-title fw-bold text-dark mb-1">
                                    <i class="bi bi-grid-3x3-gap me-2 text-primary"></i>
                                    Mesa @mesa.Numero
                                </h5>

                                <small class="text-muted">
                                    <i class="bi bi-people me-1"></i>
                                    @mesa.QuantidadeLugares lugares
                                </small>
                            </div>

                            @if (mesa.Status == "Livre")
                            {
                                <span class="badge bg-success rounded-2 px-2 py-1">
                                    <i class="bi bi-check-circle me-1"></i>
                                    Livre
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark rounded-2 px-2 py-1">
                                    <i class="bi bi-exclamation-circle me-1"></i>
                                    @mesa.Status
                                </span>
                            }
                        </div>

                        <small class="text-muted mb-3">
                            <i class="bi bi-key me-1"></i>
                            <span class="text-break">
                                @mesa.Id.ToString().Substring(0, 12)...
                            </span>
                        </small>

                        <div class="mt-auto d-flex flex-wrap gap-2">
                            <a class="btn btn-outline-secondary btn-sm rounded-2 flex-grow-1" asp-action="Detalhes"
                               asp-route-id="@mesa.Id" title="Visualizar detalhes">
                                <i class="bi bi-eye me-1"></i>
                                Ver
                            </a>

                            <a class="btn btn-outline-primary btn-sm rounded-2 flex-grow-1" asp-action="Editar"
                               asp-route-id="@mesa.Id" title="Editar mesa">
                                <i class="bi bi-pencil me-1"></i>
                                Editar
                            </a>

                            <a class="btn btn-outline-danger btn-sm rounded-2 flex-grow-1" asp-action="Excluir"
                               asp-route-id="@mesa.Id" title="Excluir mesa">
                                <i class="bi bi-trash me-1"></i>
                                Excluir
                            </a>
                        </div>

                    </div>
                </div>
            </div>
        }
    </div>

    <div class="alert alert-info mt-4 border-start border-4 rounded-3" role="alert">
        <i class="bi bi-shield-check me-2"></i>
        <strong>Privacidade Garantida:</strong>
        Você só vê mesas do seu bar. Nenhum outro usuário tem acesso a
        essas informações.
    </div>
}
