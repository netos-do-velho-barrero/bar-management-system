@model ControleDeBar.WebApp.Modulos.ModuloMesa.EditarMesaViewModel

@{
    ViewData["Title"] = "Editar Mesa";
}

<h1>Editar Mesa</h1>

<form asp-action="Editar" method="post">

    <input asp-for="Id" type="hidden" />

    <div class="mb-3">
        <label asp-for="Numero" class="form-label"></label>
        <input asp-for="Numero" class="form-control" />
        <span asp-validation-for="Numero" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="QuantidadeLugares" class="form-label"></label>
        <input asp-for="QuantidadeLugares" class="form-control" />
        <span asp-validation-for="QuantidadeLugares" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">
        Salvar alterações
    </button>

    <a asp-action="Listar" class="btn btn-secondary">
        Voltar
    </a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

